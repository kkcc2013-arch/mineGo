{
  "uid": "minego-service-topology",
  "title": "mineGo 服务调用拓扑",
  "description": "基于 Jaeger 链路数据的服务依赖图（REQ-00042）",
  "tags": [
    "minego",
    "REQ-00042"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "nodeGraph",
      "title": "服务调用拓扑（Jaeger 依赖图）",
      "datasource": {
        "type": "jaeger",
        "uid": "jaeger"
      },
      "gridPos": {
        "h": 18,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "jaeger",
            "uid": "jaeger"
          },
          "queryType": "dependencyGraph"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "节点为服务，边为调用关系与调用次数；数据来自 Jaeger（服务需配置 OTEL_EXPORTER_OTLP_ENDPOINT 上报链路）"
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "各服务请求量（次/秒）",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service) (rate(minego_http_requests_total[5m]))",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "table",
      "title": "网关最近链路",
      "datasource": {
        "type": "jaeger",
        "uid": "jaeger"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "jaeger",
            "uid": "jaeger"
          },
          "queryType": "search",
          "service": "api-gateway",
          "limit": 20
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "点击 Trace ID 查看完整跨服务调用链"
    }
  ]
}

{
  "purpose": "Fast-storage diagnostic only; exact-source original GitHub gate remains required",
  "image": "postgis/postgis:15-3.4-alpine",
  "cpuLimitNanoCpus": 1000000000,
  "memoryLimitBytes": 536870912,
  "tmpfs": {
    "/var/lib/postgresql/data": "rw,size=256m"
  },
  "postgresArguments": [
    "-c",
    "shared_preload_libraries=pg_stat_statements",
    "-c",
    "max_connections=20",
    "-c",
    "shared_buffers=64MB",
    "-c",
    "max_wal_size=128MB"
  ]
}

{
  "dashboard": {
    "title": "E05/E13：成就与通知",
    "tags": [
      "minego",
      "achievements",
      "notifications"
    ],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 0,
    "refresh": "30s",
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "游戏事件处理速率（按类型）",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        },
        "datasource": "Prometheus",
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        },
        "targets": [
          {
            "expr": "sum(rate(minego_game_events_processed_total[5m])) by (type, status)",
            "legendFormat": "{{type}} {{status}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 2,
        "title": "事件→处理延迟 P50/P95",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        },
        "datasource": "Prometheus",
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.5, sum(rate(minego_game_event_lag_seconds_bucket[5m])) by (le))",
            "legendFormat": "P50",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(minego_game_event_lag_seconds_bucket[5m])) by (le))",
            "legendFormat": "P95",
            "refId": "B"
          }
        ]
      },
      {
        "id": 3,
        "title": "成就解锁（按稀有度）",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        },
        "datasource": "Prometheus",
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        },
        "targets": [
          {
            "expr": "sum(increase(minego_achievements_unlocked_total[1h])) by (rarity)",
            "legendFormat": "{{rarity}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 4,
        "title": "称号解锁",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 8
        },
        "datasource": "Prometheus",
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        },
        "targets": [
          {
            "expr": "sum(increase(minego_titles_unlocked_total[1h])) by (source)",
            "legendFormat": "{{source}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 5,
        "title": "通知投递（按渠道/结果）",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 16
        },
        "datasource": "Prometheus",
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        },
        "targets": [
          {
            "expr": "sum(rate(minego_notifications_delivered_total[5m])) by (channel, result)",
            "legendFormat": "{{channel}} {{result}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 6,
        "title": "实时推送延迟 P95",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 16
        },
        "datasource": "Prometheus",
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(minego_notification_delivery_seconds_bucket[5m])) by (le))",
            "legendFormat": "P95",
            "refId": "A"
          }
        ]
      },
      {
        "id": 7,
        "title": "通知 WebSocket 在线连接",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 24
        },
        "datasource": "Prometheus",
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        },
        "targets": [
          {
            "expr": "sum(minego_notification_ws_connections)",
            "legendFormat": "connections",
            "refId": "A"
          }
        ]
      },
      {
        "id": 8,
        "title": "成就处理耗时 P95",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 24
        },
        "datasource": "Prometheus",
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(minego_achievement_processing_seconds_bucket[5m])) by (le))",
            "legendFormat": "P95",
            "refId": "A"
          }
        ]
      }
    ]
  },
  "overwrite": true
}
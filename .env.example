# mineGo 运行配置示例 —— 复制为 .env 后填写真实值（.env 已在 .gitignore 中，禁止提交）
# 生成随机密钥：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

NODE_ENV=production

# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=pmg
POSTGRES_USER=pmg_user
POSTGRES_PASSWORD=

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT（access / refresh 必须不同）
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=24h
JWT_REFRESH_TTL=30d

# 敏感字段加密（REQ-00565）
# FIELD_ENCRYPTION_KEYS 格式：kid:64位hex[,kid:64位hex]，轮换时追加新 kid 并修改 ACTIVE_KID
FIELD_ENCRYPTION_KEYS=
FIELD_ENCRYPTION_ACTIVE_KID=
# 盲索引 HMAC 密钥（64 位 hex），设定后不可更换，否则无法按手机号查询
FIELD_HASH_KEY=

# 支付渠道密钥（未配置的渠道在 production 下自动禁用）
WECHAT_SECRET=
ALIPAY_SECRET=
APPLE_SHARED_SECRET=

# 仅开发环境：短信验证码随响应返回（production 下强制无效）
SMS_DEV_MODE=false

# 反向代理信任（默认只信任本机回环）
TRUST_PROXY=loopback

# PM2 实例数（小机器可调成 1）
GATEWAY_INSTANCES=2
LOCATION_INSTANCES=2
CATCH_INSTANCES=2
# 道馆战斗 WebSocket 端口（原默认 8086 与 social-service 冲突）
WS_BATTLE_PORT=8089

# 游戏日时区：签到/每日任务/每日上限的日期边界；同时设置为服务进程与数据库会话时区
GAME_TIMEZONE=Asia/Shanghai
